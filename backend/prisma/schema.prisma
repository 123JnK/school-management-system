//======================================================================
//
// PURPOSE
// -------
// Defines the accounting hierarchy used throughout the ERP.
//
// Examples:
//
// Assets
// ├── Cash
// ├── Bank
//
// Liabilities
// ├── Security Deposit
//
// Income
// ├── Tuition Fee
// ├── Admission Fee
//
// Expenses
// ├── Salary
// ├── Electricity
//
//======================================================================

//======================================================================
// ACCOUNT CATEGORY
//======================================================================

enum AccountCategory {
  ASSET

  LIABILITY

  EQUITY

  INCOME

  EXPENSE
}

//======================================================================
// ACCOUNT NATURE
//======================================================================

enum AccountNature {
  DEBIT

  CREDIT
}

//======================================================================
// CHART OF ACCOUNTS
//======================================================================

model ChartOfAccount {
  //=========================
  // Primary Key
  //=========================

  id String @id @default(cuid())

  //=========================
  // School
  //=========================

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //=========================
  // Account Information
  //=========================

  accountCode String

  accountName String

  accountCategory AccountCategory

  accountNature AccountNature

  description String?

  //=========================
  // Parent Account
  //=========================

  parentAccountId String?

  parentAccount ChartOfAccount? @relation("ChartHierarchy", fields: [parentAccountId], references: [id])

  childAccounts ChartOfAccount[] @relation("ChartHierarchy")

  //=========================
  // Ledger Mapping
  //=========================

  ledgerId String?

  ledger FinancialLedger? @relation(fields: [ledgerId], references: [id])

  //=========================
  // Settings
  //=========================

  isSystemAccount Boolean @default(false)

  isActive Boolean @default(true)

  //=========================
  // Audit
  //=========================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //=========================
  // Constraints
  //=========================
  @@unique([schoolId, accountCode])
  @@unique([schoolId, accountName])
  @@index([schoolId])
  @@index([accountCategory])
  @@index([isActive])
}
//======================================================================
// SECTION 22.3
// VOUCHER MANAGEMENT
//======================================================================
//
// PURPOSE
// -------
// Every financial transaction in the ERP generates a Voucher.
//
// This follows Double Entry Accounting.
//
// Example
//
// Student Fee Paid:
//
// Debit
//    Cash
//
// Credit
//    Tuition Fee
//
//======================================================================

//======================================================================
// VOUCHER TYPE
//======================================================================

enum VoucherType {
  PAYMENT

  RECEIPT

  JOURNAL

  CONTRA

  SALES

  PURCHASE

  REFUND
}

//======================================================================
// VOUCHER STATUS
//======================================================================

enum VoucherStatus {
  DRAFT

  POSTED

  CANCELLED
}

//======================================================================
// FINANCIAL VOUCHER
//======================================================================

model FinancialVoucher {
  //======================================================
  // PRIMARY KEY
  //======================================================

  id String @id @default(cuid())

  //======================================================
  // SCHOOL
  //======================================================

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //======================================================
  // BASIC INFORMATION
  //======================================================

  voucherNumber String

  voucherType VoucherType

  voucherDate DateTime

  description String?

  //======================================================
  // AMOUNT
  //======================================================

  totalAmount Decimal @db.Decimal(15, 2)

  //======================================================
  // STATUS
  //======================================================

  status VoucherStatus @default(DRAFT)

  //======================================================
  // SOURCE MODULE
  //======================================================

  sourceModule String?

  sourceDocumentId String?

  //======================================================
  // FUTURE REFERENCES
  //======================================================

  studentId String?

  employeeId String?

  vendorId String?

  //======================================================
  // RELATIONS
  //======================================================

  entries VoucherEntry[]

  //======================================================
  // AUDIT
  //======================================================

  createdByUserId String?

  approvedByUserId String?

  approvedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  PaymentCollection PaymentCollection[]
  PayrollProcess    PayrollProcess[]
  PayrollPayment    PayrollPayment[]

  //======================================================
  // CONSTRAINTS
  //======================================================
  @@unique([schoolId, voucherNumber])
  @@index([schoolId])
  @@index([voucherType])
  @@index([voucherDate])
  @@index([status])
}

//======================================================================
// VOUCHER ENTRY
//======================================================================
//
// PURPOSE
// -------
// Every Voucher contains
// one or more debit entries
// and one or more credit entries.
//
//======================================================================

enum EntryType {
  DEBIT

  CREDIT
}

model VoucherEntry {
  id String @id @default(cuid())

  //======================================================
  // VOUCHER
  //======================================================

  voucherId String

  voucher FinancialVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  //======================================================
  // LEDGER
  //======================================================

  ledgerId String

  ledger FinancialLedger @relation(fields: [ledgerId], references: [id])

  //======================================================
  // ENTRY
  //======================================================

  entryType EntryType

  amount Decimal @db.Decimal(15, 2)

  narration String?

  //======================================================
  // AUDIT
  //======================================================

  createdAt DateTime @default(now())

  //======================================================
  // INDEXES
  //======================================================
  @@index([voucherId])
  @@index([ledgerId])
}

//======================================================================
// SECTION 22.4
// PAYMENT COLLECTION
//======================================================================
//
// PURPOSE
// -------
// Stores payment collection details.
//
// NOTE
// ----
// This is NOT the accounting entry.
// Accounting is handled by FinancialVoucher.
//
// PaymentCollection links operational modules
// with the accounting system.
//
//======================================================================

//======================================================================
// PAYMENT SOURCE
//======================================================================

enum PaymentSource {
  ADMISSION

  STUDENT_FEE

  TRANSPORT

  HOSTEL

  LIBRARY

  STORE

  EXAMINATION

  CERTIFICATE

  OTHER
}

//======================================================================
// PAYMENT MODE
//======================================================================

enum PaymentMode {
  CASH

  CHEQUE

  DD

  UPI

  NET_BANKING

  CREDIT_CARD

  DEBIT_CARD

  QR_CODE

  ONLINE_GATEWAY
}

//======================================================================
// PAYMENT STATUS
//======================================================================

enum PaymentCollectionStatus {
  PENDING

  SUCCESS

  FAILED

  CANCELLED

  REFUNDED
}

//======================================================================
// PAYMENT COLLECTION
//======================================================================

model PaymentCollection {
  //=========================
  // Primary Key
  //=========================

  id String @id @default(cuid())

  //=========================
  // School
  //=========================

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //=========================
  // Voucher
  //=========================

  voucherId String?

  voucher FinancialVoucher? @relation(fields: [voucherId], references: [id])

  //=========================
  // Source
  //=========================

  paymentSource PaymentSource

  sourceRecordId String?

  //=========================
  // Student
  //=========================

  studentId String?

  //=========================
  // Amount
  //=========================

  amount Decimal @db.Decimal(15, 2)

  //=========================
  // Payment Details
  //=========================

  paymentMode PaymentMode

  paymentDate DateTime

  transactionReference String?

  bankName String?

  chequeNumber String?

  chequeDate DateTime?

  //=========================
  // Online Gateway
  //=========================

  gatewayName String?

  gatewayTransactionId String?

  //=========================
  // Receipt
  //=========================

  receiptNumber String?

  //=========================
  // Status
  //=========================

  status PaymentCollectionStatus @default(PENDING)

  remarks String?

  //=========================
  // Audit
  //=========================

  collectedByUserId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //=========================
  // Constraints
  //=========================
  @@index([schoolId])
  @@index([studentId])
  @@index([voucherId])
  @@index([paymentSource])
  @@index([status])
}

//======================================================================
// SECTION 22.5
// PAYROLL MANAGEMENT
//======================================================================
//
// PURPOSE
// -------
// Handles employee salary processing.
//
// Integrates with:
//
// HR
// Employee
// Attendance
// Leave
// Finance
// Bank
//
//======================================================================

//======================================================================
// PAYROLL STATUS
//======================================================================

enum PayrollStatus {
  DRAFT

  PROCESSING

  APPROVED

  PAID

  CANCELLED
}

//======================================================================
// SALARY COMPONENT TYPE
//======================================================================

enum SalaryComponentType {
  EARNING

  DEDUCTION
}

//======================================================================
// SALARY COMPONENT
//======================================================================

model SalaryComponent {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  componentCode String

  componentName String

  componentType SalaryComponentType

  taxable Boolean @default(false)

  active Boolean @default(true)

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  EmployeeSalaryComponent EmployeeSalaryComponent[]

  @@unique([schoolId, componentCode])
}

//======================================================================
// EMPLOYEE SALARY STRUCTURE
//======================================================================

model EmployeeSalaryStructure {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  employeeId String

  basicSalary Decimal @db.Decimal(15, 2)

  grossSalary Decimal @db.Decimal(15, 2)

  effectiveFrom DateTime

  effectiveTo DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  EmployeeSalaryComponent EmployeeSalaryComponent[]

  @@index([employeeId])
}

//======================================================================
// PAYROLL PROCESS
//======================================================================

model PayrollProcess {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  payrollMonth Int

  payrollYear Int

  payrollStatus PayrollStatus @default(DRAFT)

  processedDate DateTime?

  approvedDate DateTime?

  voucherId String?

  voucher FinancialVoucher? @relation(fields: [voucherId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  PayrollSlip PayrollSlip[]

  @@unique([schoolId, payrollMonth, payrollYear])
}

//======================================================================
// PAYROLL SLIP
//======================================================================

model PayrollSlip {
  id String @id @default(cuid())

  payrollProcessId String

  payrollProcess PayrollProcess @relation(fields: [payrollProcessId], references: [id], onDelete: Cascade)

  employeeId String

  grossSalary Decimal @db.Decimal(15, 2)

  totalAllowance Decimal @db.Decimal(15, 2)

  totalDeduction Decimal @db.Decimal(15, 2)

  netSalary Decimal @db.Decimal(15, 2)

  generatedDate DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  PayrollPayment PayrollPayment?

  @@index([employeeId])
}

//======================================================================
// PAYROLL PAYMENT
//======================================================================

model PayrollPayment {
  id String @id @default(cuid())

  payrollSlipId String @unique

  payrollSlip PayrollSlip @relation(fields: [payrollSlipId], references: [id], onDelete: Cascade)

  paymentDate DateTime?

  paymentMode PaymentMode

  transactionReference String?

  voucherId String?

  voucher FinancialVoucher? @relation(fields: [voucherId], references: [id])

  remarks String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//======================================================================
// SECTION 22.5.1
// EMPLOYEE SALARY COMPONENT
//======================================================================
//
// PURPOSE
// -------
// Maps salary components to an employee's salary structure.
//
// This allows every school to create completely custom salary structures
// without modifying the database.
//
//======================================================================

model EmployeeSalaryComponent {
  //======================================================
  // Primary Key
  //======================================================

  id String @id @default(cuid())

  //======================================================
  // Salary Structure
  //======================================================

  salaryStructureId String

  salaryStructure EmployeeSalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  //======================================================
  // Salary Component
  //======================================================

  salaryComponentId String

  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  //======================================================
  // Component Amount
  //======================================================

  amount Decimal @db.Decimal(15, 2)

  percentage Decimal? @db.Decimal(6, 2)

  calculationFormula String?

  //======================================================
  // Settings
  //======================================================

  isFixed Boolean @default(true)

  active Boolean @default(true)

  //======================================================
  // Audit
  //======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //======================================================
  // Constraints
  //======================================================
  @@unique([salaryStructureId, salaryComponentId])
  @@index([salaryStructureId])
  @@index([salaryComponentId])
}
//======================================================================
// SECTION 22.6
// VENDOR & SUPPLIER MANAGEMENT
//======================================================================
//
// PURPOSE
// -------
// Central vendor master used across the ERP.
//
// Used By:
// • Inventory & Assets
// • School Store
// • Hostel
// • Transport
// • Maintenance
// • Finance
//
//======================================================================

//======================================================================
// VENDOR STATUS
//======================================================================

enum VendorStatus {
  ACTIVE

  INACTIVE

  BLOCKED
}

//======================================================================
// VENDOR CATEGORY
//======================================================================

enum VendorCategory {
  BOOKS

  NOTEBOOKS

  UNIFORMS

  STATIONERY

  TRANSPORT

  HOSTEL

  MAINTENANCE

  ELECTRICAL

  FURNITURE

  COMPUTER

  PRINTING

  FOOD

  CONTRACTOR

  OTHER
}

//======================================================================
// VENDOR MASTER
//======================================================================

model Vendor {
  //======================================================
  // PRIMARY KEY
  //======================================================

  id String @id @default(cuid())

  //======================================================
  // SCHOOL
  //======================================================

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //======================================================
  // BASIC INFORMATION
  //======================================================

  vendorCode String

  vendorName String

  category VendorCategory

  status VendorStatus @default(ACTIVE)

  //======================================================
  // CONTACT INFORMATION
  //======================================================

  contactPerson String?

  mobileNumber String?

  alternateMobile String?

  email String?

  website String?

  //======================================================
  // ADDRESS
  //======================================================

  addressLine1 String?

  addressLine2 String?

  city String?

  district String?

  state String?

  country String?

  pinCode String?

  //======================================================
  // TAX DETAILS
  //======================================================

  gstNumber String?

  panNumber String?

  //======================================================
  // BANK DETAILS
  //======================================================

  accountHolderName String?

  bankName String?

  accountNumber String?

  ifscCode String?

  branchName String?

  //======================================================
  // FINANCIAL
  //======================================================

  openingBalance Decimal @default(0) @db.Decimal(15, 2)

  creditLimit Decimal? @db.Decimal(15, 2)

  //======================================================
  // NOTES
  //======================================================

  remarks String?

  //======================================================
  // AUDIT
  //======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //======================================================
  // CONSTRAINTS
  //======================================================
  @@unique([schoolId, vendorCode])
  @@index([schoolId])
  @@index([category])
  @@index([status])
}

//======================================================================
// SECTION 22.7
// FINANCIAL RECONCILIATION
//======================================================================
//
// PURPOSE
// -------
// Tracks reconciliation between ERP financial records
// and actual cash, bank, payment gateway,
// or external financial statements.
//
//======================================================================

//======================================================================
// RECONCILIATION TYPE
//======================================================================

enum ReconciliationType {
  CASH

  BANK

  PAYMENT_GATEWAY

  STUDENT_LEDGER

  VENDOR_LEDGER

  PAYROLL
}

//======================================================================
// RECONCILIATION STATUS
//======================================================================

enum ReconciliationStatus {
  PENDING

  PARTIAL

  COMPLETED

  MISMATCH
}

//======================================================================
// FINANCIAL RECONCILIATION
//======================================================================

model FinancialReconciliation {
  id String @id @default(cuid())

  //======================================================
  // SCHOOL
  //======================================================

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //======================================================
  // BASIC INFORMATION
  //======================================================

  reconciliationNumber String

  reconciliationType ReconciliationType

  reconciliationDate DateTime

  //======================================================
  // AMOUNTS
  //======================================================

  systemAmount Decimal @db.Decimal(15, 2)

  actualAmount Decimal @db.Decimal(15, 2)

  differenceAmount Decimal @db.Decimal(15, 2)

  //======================================================
  // STATUS
  //======================================================

  status ReconciliationStatus @default(PENDING)

  remarks String?

  //======================================================
  // AUDIT
  //======================================================

  verifiedByUserId String?

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //======================================================
  // CONSTRAINTS
  //======================================================
  @@unique([schoolId, reconciliationNumber])
  @@index([schoolId])
  @@index([reconciliationType])
  @@index([status])
}

