  updatedAt DateTime @updatedAt

  AssetTransfer AssetTransfer[]
  AssetAMC      AssetAMC[]
  AssetAudit    AssetAudit[]
  AssetDisposal AssetDisposal[]
  AssetHistory  AssetHistory[]

  //------------------------------------------------------------
  @@unique([schoolId, assetCode])
  @@index([schoolId])
  @@index([category])
  @@index([status])
}

