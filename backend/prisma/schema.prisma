//============================================================
// MySchool Platform
// Prisma Schema V02
// Version : 1.0 Foundation
// Architecture : Multi-Tenant School ERP SaaS
//
// This schema is designed to support:
//
// ✔ Android App
// ✔ Web Portal
// ✔ Multi-School SaaS
// ✔ AI Features
// ✔ Future Enterprise Expansion
//
// IMPORTANT
// ----------
// • Never delete production models.
// • New features should extend the schema.
// • Prefer optional fields over destructive changes.
//============================================================

//============================================================
// SECTION 01
// PRISMA CONFIGURATION
//============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//============================================================
// SECTION 02
// GLOBAL ENUMS
//============================================================

//------------------------------------------------------------
// Subscription
//------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

//------------------------------------------------------------
// School
//------------------------------------------------------------

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

//------------------------------------------------------------
// User Roles
// NOTE:
// This is ONLY for authentication.
// Employee responsibilities are handled separately.
//------------------------------------------------------------

enum UserRole {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  EMPLOYEE
  STUDENT
  PARENT
}

//------------------------------------------------------------
// Employee
//------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
  RETIRED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
  INTERN
}

//------------------------------------------------------------
// Gender
//------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
}

//------------------------------------------------------------
// Teacher
//------------------------------------------------------------

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

//============================================================
// SECTION 03
// FOUNDATION MODULE
//============================================================
//
// This section contains the core entities of the ERP.
// Every other module depends on these tables.
//
// Models
// -------
// School
// SchoolSettings
// AcademicSession
// AcademicYear
// HolidayCalendar
//
//============================================================

//============================================================
// SCHOOL
//============================================================

model School {
  id String @id @default(cuid())

  // ---------- Basic Information ----------
  name String
  code String @unique

  email String  @unique
  phone String?

  website String?

  logo String?

  principalName String?

  // ---------- Address ----------
  address  String?
  city     String?
  district String?
  state    String?
  country  String?
  pincode  String?

  // ---------- Subscription ----------
  subscription SubscriptionPlan @default(TRIAL)

  status SchoolStatus @default(ACTIVE)

  // ---------- Relationships ----------
  settings SchoolSettings?

  users User[]

  employees Employee[]

  teachers Teacher[]

  departments Department[]

  designations Designation[]

  academicYears AcademicYear[]

  academicSessions AcademicSession[]

  holidayCalendars HolidayCalendar[]

  // ---------- Audit ----------
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  Student                    Student[]
  Parent                     Parent[]
  AcademicClass              AcademicClass[]
  AcademicSection            AcademicSection[]
  Subject                    Subject[]
  House                      House[]
  WorkingDay                 WorkingDay[]
  SchoolPeriod               SchoolPeriod[]
  ClassTimetable             ClassTimetable[]
  StudentAttendance          StudentAttendance[]
  Exam                       Exam[]
  FeeHead                    FeeHead[]
  FeeStructure               FeeStructure[]
  Homework                   Homework[]
  StudyMaterial              StudyMaterial[]
  Notification               Notification[]
  Announcement               Announcement[]
  Message                    Message[]
  BookCategory               BookCategory[]
  Book                       Book[]
  BookIssue                  BookIssue[]
  StudentLedger              StudentLedger[]
  Vehicle                    Vehicle[]
  Driver                     Driver[]
  Conductor                  Conductor[]
  TransportRoute             TransportRoute[]
  TransportFeePlan           TransportFeePlan[]
  StudentTransportAllocation StudentTransportAllocation[]
  VehicleMaintenance         VehicleMaintenance[]
  Hostel                     Hostel[]
  HostelFeePlan              HostelFeePlan[]
  StudentHostelAllocation    StudentHostelAllocation[]
  HostelWarden               HostelWarden[]
  HostelVisitor              HostelVisitor[]
  HostelLeave                HostelLeave[]
  StoreProduct               StoreProduct[]
  StoreVendor                StoreVendor[]
  PurchaseOrder              PurchaseOrder[]
  InventoryTransaction       InventoryTransaction[]
  StudentStoreInvoice        StudentStoreInvoice[]
  Asset                      Asset[]
  AdmissionEnquiry           AdmissionEnquiry[]
  AdmissionApplication       AdmissionApplication[]
  FinancialLedger            FinancialLedger[]
  ChartOfAccount             ChartOfAccount[]
  FinancialVoucher           FinancialVoucher[]
  PaymentCollection          PaymentCollection[]
  SalaryComponent            SalaryComponent[]
  EmployeeSalaryStructure    EmployeeSalaryStructure[]
  PayrollProcess             PayrollProcess[]
  Vendor                     Vendor[]
  FinancialReconciliation    FinancialReconciliation[]
}

//============================================================
// SCHOOL SETTINGS
//============================================================

model SchoolSettings {
  id String @id @default(cuid())

  schoolId String @unique

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // Academic
  //----------------------------------------------------------

  currentAcademicYear String

  //----------------------------------------------------------
  // Regional Settings
  //----------------------------------------------------------

  timezone String @default("Asia/Kolkata")

  currency String @default("INR")

  language String @default("en")

  //----------------------------------------------------------
  // Academic Behaviour
  //----------------------------------------------------------

  gradingSystem String @default("PERCENTAGE")

  attendanceMethod String @default("DAILY")

  //----------------------------------------------------------
  // Enabled Modules
  //----------------------------------------------------------

  enableAttendance Boolean @default(true)

  enableHomework Boolean @default(true)

  enableFee Boolean @default(true)

  enableExamination Boolean @default(true)

  enableTransport Boolean @default(false)

  enableLibrary Boolean @default(false)

  enableHostel Boolean @default(false)

  enableAI Boolean @default(true)

  //----------------------------------------------------------
  // Audit
  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//============================================================
// ACADEMIC YEAR
//============================================================

model AcademicYear {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  startDate DateTime

  endDate DateTime

  isCurrent Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  AcademicSession      AcademicSession[]
  StudentEnrollment    StudentEnrollment[]
  SubjectTeacher       SubjectTeacher[]
  AcademicClassTeacher AcademicClassTeacher[]
  ClassTimetable       ClassTimetable[]
  Exam                 Exam[]
  FeeStructure         FeeStructure[]
  Homework             Homework[]
  StudentLedger        StudentLedger[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

//============================================================
// ACADEMIC SESSION
//============================================================

model AcademicSession {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYearId String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  name String

  startDate DateTime

  endDate DateTime

  isCurrent Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

//============================================================
// HOLIDAY CALENDAR
//============================================================

model HolidayCalendar {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title String

  holidayDate DateTime

  description String?

  isPublicHoliday Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

//============================================================
// SECTION 04
// IDENTITY & USER MANAGEMENT
//============================================================
//
// PURPOSE
// -------
// Authentication and Login
//
// Every person who can log into the system has ONE User account.
//
// Examples:
// Platform Admin
// School Admin
// Teacher
// Principal
// Driver
// Accountant
// Student
// Parent
//
// NOTE
// ----
// User stores ONLY authentication information.
//
// Employee information is stored separately.
//
//============================================================

model User {
  //----------------------------------------------------------
  // PRIMARY KEY
  //----------------------------------------------------------

  id String @id @default(cuid())

  //----------------------------------------------------------
  // SCHOOL
  //----------------------------------------------------------

  schoolId String?

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // LOGIN
  //----------------------------------------------------------

  email String @unique

  password String

  role UserRole

  //----------------------------------------------------------
  // PROFILE
  //----------------------------------------------------------

  firstName String

  lastName String?

  mobile String?

  gender Gender?

  profilePhoto String?

  //----------------------------------------------------------
  // ACCOUNT STATUS
  //----------------------------------------------------------

  isActive Boolean @default(true)

  emailVerified Boolean @default(false)

  mobileVerified Boolean @default(false)

  //----------------------------------------------------------
  // SECURITY
  //----------------------------------------------------------

  lastLogin DateTime?

  loginAttempts Int @default(0)

  accountLocked Boolean @default(false)

  accountLockedUntil DateTime?

  passwordChangedAt DateTime?

  //----------------------------------------------------------
  // FUTURE FEATURES
  //----------------------------------------------------------

  twoFactorEnabled Boolean @default(false)

  preferredLanguage String?

  theme String?

  //----------------------------------------------------------
  // RELATIONS
  //----------------------------------------------------------

  employee Employee?

  student Student?

  parent Parent?

  //----------------------------------------------------------
  // SOFT DELETE
  //----------------------------------------------------------

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  deletedBy String?

  //----------------------------------------------------------
  // AUDIT
  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  NotificationDelivery NotificationDelivery[]

  //----------------------------------------------------------
  // INDEXES
  //----------------------------------------------------------
  @@index([schoolId])
  @@index([role])
  @@index([isActive])
  @@index([isDeleted])
}

//============================================================
// SECTION 05
// HUMAN RESOURCE (HR) CORE
//============================================================
//
// PURPOSE
// -------
// Every staff member is first an Employee.
//
// Examples:
// Teacher
// Principal
// Vice Principal
// Academic Coordinator
// Accountant
// Clerk
// Receptionist
// Librarian
// Driver
// Transport Manager
// Lab Assistant
//
// Specialized modules (Teacher, Driver, etc.) extend Employee.
//
//============================================================

//============================================================
// DEPARTMENT
//============================================================

model Department {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  code String

  description String?

  isActive Boolean @default(true)

  designations Designation[]

  employees Employee[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

//============================================================
// DESIGNATION
//============================================================

model Designation {
  id String @id @default(cuid())

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  departmentId String?

  department Department? @relation(fields: [departmentId], references: [id])

  name String

  level Int @default(1)

  description String?

  isActive Boolean @default(true)

  employees Employee[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

//============================================================
// EMPLOYEE
//============================================================

model Employee {
  //----------------------------------------------------------
  // PRIMARY KEY
  //----------------------------------------------------------

  id String @id @default(cuid())

  //----------------------------------------------------------
  // SCHOOL
  //----------------------------------------------------------

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // USER ACCOUNT
  //----------------------------------------------------------

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // BASIC DETAILS
  //----------------------------------------------------------

  employeeCode String

  firstName String

  lastName String?

  gender Gender?

  dateOfBirth DateTime?

  //----------------------------------------------------------
  // CONTACT
  //----------------------------------------------------------

  mobile String?

  email String?

  address String?

  emergencyContact String?

  //----------------------------------------------------------
  // HR DETAILS
  //----------------------------------------------------------

  departmentId String?

  department Department? @relation(fields: [departmentId], references: [id])

  designationId String?

  designation Designation? @relation(fields: [designationId], references: [id])

  joiningDate DateTime

  employmentType EmploymentType @default(FULL_TIME)

  status EmployeeStatus @default(ACTIVE)

  //----------------------------------------------------------
  // PROFESSIONAL
  //----------------------------------------------------------

  qualification String?

  experienceYears Int?

  bloodGroup String?

  profilePhoto String?

  //----------------------------------------------------------
  // SPECIALIZED MODULES
  //----------------------------------------------------------

  teacher Teacher?

  employeeRoles EmployeeRole[]

  //----------------------------------------------------------
  // SOFT DELETE
  //----------------------------------------------------------

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  deletedBy String?

  //----------------------------------------------------------
  // AUDIT
  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  EmployeeAttendance EmployeeAttendance[]
  BookIssue          BookIssue[]
  Driver             Driver[]
  Conductor          Conductor[]
  HostelWarden       HostelWarden[]

  //----------------------------------------------------------
  // INDEXES
  //----------------------------------------------------------
  @@unique([schoolId, employeeCode])
  @@index([schoolId])
  @@index([status])
  @@index([departmentId])
  @@index([designationId])
  @@index([isDeleted])
}

//============================================================
// EMPLOYEE ROLE
//============================================================
//
// Multiple responsibilities can be assigned
// to one employee.
//
// Example:
//
// Teacher
// Academic Coordinator
// Exam Controller
// Library Incharge
//
//============================================================

model EmployeeRole {
  id String @id @default(cuid())

  employeeId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  roleName String

  isPrimary Boolean @default(false)

  startDate DateTime?

  endDate DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

//============================================================
// SECTION 06
// TEACHER MODULE
//============================================================
//
// PURPOSE
// -------
// Stores ONLY teaching-specific information.
//
// HR information remains in Employee.
//
// Future Extensions
// -----------------
// • Subject Allocation
// • Class Teacher
// • Timetable
// • Lesson Planning
// • Homework
// • AI Analytics
//============================================================

//============================================================
// TEACHER
//============================================================

model Teacher {
  //----------------------------------------------------------
  // PRIMARY KEY
  //----------------------------------------------------------

  id String @id @default(cuid())

  //----------------------------------------------------------
  // EMPLOYEE
  //----------------------------------------------------------

  employeeId String @unique

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // SCHOOL
  //----------------------------------------------------------

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // TEACHER DETAILS
  //----------------------------------------------------------

  teacherCode String

  employeeNumber String?

  joiningDate DateTime

  teacherStatus TeacherStatus @default(ACTIVE)

  //----------------------------------------------------------
  // ACADEMIC PROFILE
  //----------------------------------------------------------

  highestQualification String?

  specialization String?

  university String?

  teachingExperience Int?

  //----------------------------------------------------------
  // PROFESSIONAL DETAILS
  //----------------------------------------------------------

  boardRegistrationNo String?

  aadhaarNumber String?

  panNumber String?

  //----------------------------------------------------------
  // AI FUTURE
  //----------------------------------------------------------

  aiTeachingScore Float?

  aiPerformanceScore Float?

  //----------------------------------------------------------
  // FUTURE RELATIONS
  //----------------------------------------------------------

  teacherSubjects TeacherSubject[]

  classTeachers ClassTeacher[]

  //----------------------------------------------------------
  // AUDIT
  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  SubjectTeacher       SubjectTeacher[]
  AcademicClassTeacher AcademicClassTeacher[]
  Homework             Homework[]
  StudyMaterial        StudyMaterial[]

  //----------------------------------------------------------
  // INDEXES
  //----------------------------------------------------------
  @@unique([schoolId, teacherCode])
  @@index([schoolId])
  @@index([teacherStatus])
}

//============================================================
// TEACHER SUBJECT
//============================================================
//
// One teacher can teach multiple subjects.
//
// Example:
//
// Rajesh
// ├── Physics
// ├── Mathematics
// └── Computer Science
//
//============================================================

model TeacherSubject {
  id String @id @default(cuid())

  teacherId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectName String

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([teacherId])
}

//============================================================
// CLASS TEACHER
//============================================================
//
// One teacher can become class teacher
// for one or more classes.
//
//============================================================

model ClassTeacher {
  id String @id @default(cuid())

  teacherId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  academicYear String

  className String

  section String

  createdAt DateTime @default(now())

  AcademicClass     AcademicClass?   @relation(fields: [academicClassId], references: [id])
  academicClassId   String?
  AcademicSection   AcademicSection? @relation(fields: [academicSectionId], references: [id])
  academicSectionId String?

  @@index([teacherId])
}

//============================================================
// SECTION 07
// STUDENT MODULE
//============================================================
//
// PURPOSE
// -------
// Stores student academic information.
//
// LOGIN INFORMATION      -> User
// PERSONAL INFORMATION   -> Student
// PARENT INFORMATION     -> Parent
// ADMISSION HISTORY      -> StudentEnrollment
//
// Future Modules
// --------------
// • Attendance
// • Fee
// • Homework
// • Examination
// • Report Card
// • Transport
// • Library
// • Hostel
// • AI Analytics
//
//============================================================

//============================================================
// STUDENT
//============================================================

model Student {
  //----------------------------------------------------------
  // PRIMARY KEY
  //----------------------------------------------------------

  id String @id @default(cuid())

  //----------------------------------------------------------
  // SCHOOL
  //----------------------------------------------------------

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // LOGIN ACCOUNT
  //----------------------------------------------------------

  userId String? @unique

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // STUDENT IDENTITY
  //----------------------------------------------------------

  admissionNo String

  studentCode String?

  rollNo String?

  //----------------------------------------------------------
  // PERSONAL DETAILS
  //----------------------------------------------------------

  firstName String

  lastName String?

  gender Gender?

  dateOfBirth DateTime?

  bloodGroup String?

  profilePhoto String?

  //----------------------------------------------------------
  // CONTACT
  //----------------------------------------------------------

  mobile String?

  email String?

  address String?

  //----------------------------------------------------------
  // MEDICAL
  //----------------------------------------------------------

  medicalConditions String?

  allergies String?

  emergencyContact String?

  //----------------------------------------------------------
  // STATUS
  //----------------------------------------------------------

  admissionDate DateTime

  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  deletedBy String?

  //----------------------------------------------------------
  // RELATIONS
  //----------------------------------------------------------

  parents StudentParent[]

  enrollments StudentEnrollment[]

  //----------------------------------------------------------
  // AUDIT
  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  StudentAttendance          StudentAttendance[]
  StudentPeriodAttendance    StudentPeriodAttendance[]
  StudentResult              StudentResult[]
  ReportCard                 ReportCard[]
  StudentFee                 StudentFee[]
  HomeworkSubmission         HomeworkSubmission[]
  BookIssue                  BookIssue[]
  StudentLedger              StudentLedger[]
  StudentTransportAllocation StudentTransportAllocation[]
  StudentHostelAllocation    StudentHostelAllocation[]
  HostelVisitor              HostelVisitor[]
  HostelLeave                HostelLeave[]
  StudentStoreInvoice        StudentStoreInvoice[]

  //----------------------------------------------------------
  // INDEXES
  //----------------------------------------------------------
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([isActive])
  @@index([isDeleted])
}

//============================================================
// PARENT
//============================================================

model Parent {
  id String @id @default(cuid())

  //----------------------------------------------------------

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // LOGIN
  //----------------------------------------------------------

  userId String? @unique

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // DETAILS
  //----------------------------------------------------------

  fatherName String?

  motherName String?

  guardianName String?

  mobile String?

  alternateMobile String?

  email String?

  occupation String?

  annualIncome Float?

  address String?

  //----------------------------------------------------------

  students StudentParent[]

  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

//============================================================
// STUDENT PARENT
//============================================================
//
// Many-to-Many Relationship
//
// One parent can have multiple children.
// One student can have multiple guardians.
//
//============================================================

model StudentParent {
  id String @id @default(cuid())

  studentId String

  parentId String

  relation String

  isPrimary Boolean @default(false)

  //----------------------------------------------------------

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  @@unique([studentId, parentId])
}

//============================================================
// STUDENT ENROLLMENT
//============================================================
//
// Keeps complete academic history.
//
// Example
//
// 2026-27  → Class 5 → Section A
//
// 2027-28  → Class 6 → Section A
//
// Nothing is overwritten.
//
//============================================================

model StudentEnrollment {
  id String @id @default(cuid())

  //----------------------------------------------------------

  studentId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------

  academicYearId String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  //----------------------------------------------------------
  // NEW RELATIONS
  //----------------------------------------------------------

  classId String

  academicClass AcademicClass @relation(fields: [classId], references: [id])

  sectionId String?

  academicSection AcademicSection? @relation(fields: [sectionId], references: [id])

  //----------------------------------------------------------

  rollNo String?

  houseId String?

  //----------------------------------------------------------

  isCurrent Boolean @default(true)

  promoted Boolean @default(false)

  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  StudentAttendance StudentAttendance[]

  //----------------------------------------------------------
  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([classId])
  @@index([sectionId])
}

//============================================================
// SECTION 08
// ACADEMIC STRUCTURE MODULE
//============================================================
//
// PURPOSE
// -------
// Defines the complete academic structure of a school.
//
// This module controls:
//
// • Academic Years
// • Classes
// • Sections
// • Subjects
// • Class-wise Subjects
// • Class Teachers
// • Subject Teachers
// • Houses
//
// Future Extensions
// -----------------
// ✔ Timetable
// ✔ Attendance
// ✔ Homework
// ✔ Examination
// ✔ Promotion
// ✔ Report Cards
// ✔ AI Timetable Generator
//
//============================================================

//============================================================
// ACADEMIC CLASS
//============================================================
//
// Examples
//
// Nursery
// LKG
// UKG
// Class 1
// Class 2
// ...
// Class 12
//
//============================================================

model AcademicClass {
  //----------------------------------------------------------
  // PRIMARY KEY
  //----------------------------------------------------------

  id String @id @default(cuid())

  //----------------------------------------------------------
  // SCHOOL
  //----------------------------------------------------------

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------
  // CLASS DETAILS
  //----------------------------------------------------------

  className String

  classCode String

  displayOrder Int

  description String?

  isActive Boolean @default(true)

  //----------------------------------------------------------
  // RELATIONS
  //----------------------------------------------------------

  sections AcademicSection[]

  classSubjects ClassSubject[]

  subjectTeachers SubjectTeacher[]

  classTeachers ClassTeacher[]

  enrollments StudentEnrollment[]

  //----------------------------------------------------------
  // AUDIT
  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  AcademicClassTeacher AcademicClassTeacher[]
  ClassTimetable       ClassTimetable[]
  ExamSchedule         ExamSchedule[]
  FeeStructure         FeeStructure[]
  Homework             Homework[]
  StudyMaterial        StudyMaterial[]

  //----------------------------------------------------------
  // INDEXES
  //----------------------------------------------------------
  @@unique([schoolId, classCode])
  @@index([schoolId])
}

//============================================================
// ACADEMIC SECTION
//============================================================
//
// Examples
//
// A
// B
// C
//
//============================================================

model AcademicSection {
  id String @id @default(cuid())

  //----------------------------------------------------------

  schoolId String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------

  classId String

  academicClass AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  //----------------------------------------------------------

  sectionName String

  roomNumber String?

  capacity Int?

  isActive Boolean @default(true)

  //----------------------------------------------------------

  enrollments StudentEnrollment[]

  classTeachers ClassTeacher[]

  subjectTeachers SubjectTeacher[]

  //----------------------------------------------------------

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  AcademicClassTeacher AcademicClassTeacher[]
  ClassTimetable       ClassTimetable[]
  ExamSchedule         ExamSchedule[]
  Homework             Homework[]
  StudyMaterial        StudyMaterial[]

  //----------------------------------------------------------
  @@unique([classId, sectionName])
  @@index([schoolId])
}

//============================================================
// SUBJECT
//============================================================

model Subject {
  id String @id @default(cuid())

  //----------------------------------------------------------

  schoolId String

