//=====================================================================
// SECTION 16
// STUDENT FINANCIAL LEDGER (ERP FINANCIAL CORE)
//=====================================================================
//
// PURPOSE
// --------------------------------------------------------------------
// This is the CENTRAL FINANCIAL ENGINE of the ERP.
//
// Every monetary transaction related to a student will flow here.
//
// Integrated Modules:
//
// ✓ Admission
// ✓ Fee Management
// ✓ School Store
// ✓ Library Fine
// ✓ Transport
// ✓ Hostel
// ✓ Examination
// ✓ Scholarship
// ✓ Discounts
// ✓ Refunds
// ✓ Miscellaneous Charges
//
// Future:
//
// ✓ Online Payment Gateway
// ✓ Wallet
// ✓ EMI
// ✓ Auto Reminder
// ✓ AI Financial Prediction
//
// NOTE
// --------------------------------------------------------------------
// No module should directly maintain a student's outstanding balance.
// Every financial module must create transactions in this ledger.
//
//=====================================================================

//=====================================================================
// TRANSACTION TYPE
//=====================================================================

enum LedgerTransactionType {
  // Academic

  ADMISSION_FEE

  TUITION_FEE

  EXAMINATION_FEE

  ANNUAL_FEE

  DEVELOPMENT_FEE

  ACTIVITY_FEE

  // Support Services

  TRANSPORT_FEE

  HOSTEL_FEE

  LIBRARY_FINE

  STORE_PURCHASE

  // Financial

  PAYMENT_RECEIVED

  REFUND

  SCHOLARSHIP

  DISCOUNT

  FINE

  OTHER
}

//=====================================================================
// PAYMENT MODE
//=====================================================================

enum FEEPaymentMode {
