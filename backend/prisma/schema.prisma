generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  TRIAL
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

model School {
  id String @id @default(cuid())

  name  String
  code  String @unique
  email String @unique

  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  website       String?
  logo          String?
  principalName String?

  subscription SubscriptionPlan @default(TRIAL)
  status       SchoolStatus     @default(ACTIVE)

  users    User[]
  teachers Teacher[]

  settings SchoolSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolSettings {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  academicYear String

  timezone String @default("Asia/Kolkata")
  currency String @default("INR")
  language String @default("en")

  gradingSystem    String @default("PERCENTAGE")
  attendanceMethod String @default("DAILY")

  allowOnlineFee  Boolean @default(true)
  enableTransport Boolean @default(false)
  enableLibrary   Boolean @default(false)
  enableHostel    Boolean @default(false)
  enableAI        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())

  email    String @unique
  password String

  firstName String?
  lastName  String?

  phone  String?
  gender String?

  profilePhoto String?

  role UserRole @default(SCHOOL_ADMIN)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacher Teacher?

  isActive Boolean @default(true)

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schoolId, role])
  @@index([schoolId, isActive])
}

model Teacher {
  id String @id @default(cuid())

  teacherCode String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  designation String?
  department  String?

  qualification   String?
  experienceYears Int?

  employmentType EmploymentType @default(FULL_TIME)

  joiningDate DateTime

  dateOfBirth DateTime?

  bloodGroup String?

  address String?

  emergencyContact String?

  photo String?

  status TeacherStatus @default(ACTIVE)

  // ===== Soft Delete =====
  isDeleted Boolean @default(false)

  deletedAt DateTime?

  deletedBy String?

  // =======================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, teacherCode])
  @@index([schoolId])
  @@index([status])
  @@index([schoolId, status])
  @@index([isDeleted])
  @@index([schoolId, isDeleted])
}
